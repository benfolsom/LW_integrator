{
    "name": "demo_optimization",
    "description": "Demonstration optimization run using genetic algorithm to find optimal aperture and energy",
    "simulation_type": "CONDUCTING_WALL",
    "mode": "optimization",
    "aperture_min": 0.1,
    "aperture_max": 2.0,
    "aperture_points": 10,
    "aperture_log_scale": false,
    "energy_min": 1.0,
    "energy_max": 50.0,
    "energy_points": 10,
    "energy_log_scale": false,
    "transverse_offset_fractions": [0.3, 0.5, 0.7],
    "starting_z_positions": [0.0],
    "wall_z": 100.0,
    "cavity_spacing": 100000.0,
    "steps": 1000,
    "timestep": 3e-7,
    "timestep_strategy": "auto_distance",
    "target_distance_mm": 120.0,
    "pcount": 1,
    "objective": "max_percent_energy_gain",
    "save_top_n_trajectories": false,
    "trajectory_stride": 10,
    "optimization_method": "genetic_algorithm",
    "optimization_maxiter": 10,
    "optimization_population_size": 20,
    "optimization_mutation_rate": 0.1,
    "optimization_crossover_rate": 0.7,
    "optimization_n_starts": 5,
    "optimization_save_top_n": 5,
    "self_consistency_enabled": true,
    "self_consistency_tolerance": 0.0001,
    "self_consistency_max_iterations": 5,
    "self_consistency_verbosity": 0,
    "energy_monitor_halt_on_jump": false,
    "adaptive_timestep_enabled": true,
    "adaptive_timestep_threshold": 0.1,
    "adaptive_timestep_reduction_factor": 10,
    "adaptive_timestep_max_attempts": 5,
    "adaptive_timestep_min_factor": 0.0001,
    "adaptive_timestep_cooldown_steps": 10,
    "adaptive_timestep_probe_threshold": 0.01,
    "adaptive_timestep_max_probe_steps": 3,
    "adaptive_timestep_debug": false,
    "smoothness_analysis_enabled": true,
    "smoothness_window_size": 20,
    "smoothness_oscillation_threshold": 0.5,
    "smoothness_trend_threshold": 0.3,
    "smoothness_reject_on_violation": true,
    "smoothness_max_allowed_violations": 3,
    "per_run_timeout": 120.0,
    "skip_failed_runs": true,
    "seed": 42,
    "output_dir": "results/demo_optimization",
    "save_optimization_history": true,
    "save_best_trajectory": true,
    "plot_optimization_progress": true
}
